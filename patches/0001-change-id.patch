Date: Sun, 25 Oct 2026 12:26:56 +0100
Subject: [PATCH] Let a client change its ID

A RegisterPk that carries old_id renames the peer, in the database and in memory, when the uuid matches the one registered under the old ID and the new ID is free.
---
 src/database.rs          |  9 +++++++
 src/peer.rs              | 14 +++++++++++
 src/rendezvous_server.rs | 52 +++++++++++++++++++++++++++++++++++++++-
 3 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/src/database.rs b/src/database.rs
index fa1b6ed..5e5abdf 100644
--- a/src/database.rs
+++ b/src/database.rs
@@ -142,6 +142,15 @@ impl Database {
         .await?;
         Ok(())
     }
+
+    pub async fn rename_peer(&self, guid: &[u8], id: &str) -> ResultType<()> {
+        sqlx::query("update peer set id = ? where guid = ?")
+            .bind(id)
+            .bind(guid)
+            .execute(self.pool.get().await?.deref_mut())
+            .await?;
+        Ok(())
+    }
 }
 
 #[cfg(test)]
diff --git a/src/peer.rs b/src/peer.rs
index 4ca87cf..f833662 100644
--- a/src/peer.rs
+++ b/src/peer.rs
@@ -168,6 +168,20 @@ impl PeerMap {
         tmp
     }
 
+    /// Moves the peer registered as `old_id` to `id`, in the database and in memory.
+    /// Returns false when `old_id` is unknown.
+    pub(crate) async fn rename(&self, old_id: &str, id: &str) -> ResultType<bool> {
+        let Some(peer) = self.get(old_id).await else {
+            return Ok(false);
+        };
+        let guid = peer.read().await.guid.clone();
+        self.db.rename_peer(&guid, id).await?;
+        let mut map = self.map.write().await;
+        map.remove(old_id);
+        map.insert(id.to_owned(), peer);
+        Ok(true)
+    }
+
     #[inline]
     pub(crate) async fn get_in_memory(&self, id: &str) -> Option<LockPeer> {
         self.map.read().await.get(id).cloned()
