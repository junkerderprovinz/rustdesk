+    /// A client renames itself by sending its old id, the new one and its uuid. Only the
+    /// machine registered under the old id may do that, and only to an id nobody else holds.
+    async fn handle_change_id(
+        &mut self,
+        rk: RegisterPk,
+        addr: SocketAddr,
+    ) -> Result<register_pk_response::Result, register_pk_response::Result> {
+        let (old_id, id) = (rk.old_id, rk.id);
+        if rk.uuid.is_empty() || !hbb_common::is_valid_custom_id(&id) {
+            return Err(INVALID_ID_FORMAT);
+        }
+        if !self.check_ip_blocker(&addr.ip().to_string(), &old_id).await {
+            return Err(TOO_FREQUENT);
+        }
+        let Some(peer) = self.pm.get(&old_id).await else {
+            return Err(UUID_MISMATCH);
+        };
+        if peer.read().await.uuid != rk.uuid {
+            log::warn!("Change id {} -> {} refused: uuid mismatch", old_id, id);
+            return Err(UUID_MISMATCH);
+        }
+        if id == old_id {
+            return Ok(register_pk_response::Result::OK);
+        }
+        if let Some(other) = self.pm.get(&id).await {
+            let holder = other.read().await.uuid.clone();
+            if holder == rk.uuid {
+                return Ok(register_pk_response::Result::OK);
+            }
+            // An empty uuid is a placeholder left by a lookup, not a registration.
+            if !holder.is_empty() {
+                return Err(ID_EXISTS);
+            }
+        }
+        match self.pm.rename(&old_id, &id).await {
+            Ok(true) => {
+                log::info!("Changed id {} -> {}", old_id, id);
+                Ok(register_pk_response::Result::OK)
+            }
+            Ok(false) => Err(UUID_MISMATCH),
+            Err(err) => {
+                log::error!("Change id {} -> {} failed: {}", old_id, id, err);
+                Err(register_pk_response::Result::SERVER_ERROR)
+            }
+        }
+    }
+
