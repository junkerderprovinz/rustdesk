{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 6,
  "packageRules": [
    {
      "description": "rustdesk-api base image: manual review, an API update can change the console and the address book",
      "matchPackageNames": [
        "lejianwen/rustdesk-api"
      ],
      "groupName": "rustdesk-api base",
      "commitMessagePrefix": "feat:",
      "labels": [
        "base-image"
      ]
    },
    {
      "description": "GitHub Actions: auto-merge all updates (major/minor/patch/digest). No CI runs on PRs, so platformAutomerge merges as soon as the PR is open.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "commitMessagePrefix": "ci:",
      "labels": [
        "github-actions"
      ]
    },
    {
      "description": "Docker: auto-merge digest pins and digest refreshes (same tag, new build). Major/minor stay open for review.",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "commitMessagePrefix": "ci:",
      "labels": [
        "docker"
      ]
    },
    {
      "description": "The compose file is for people to copy, so it follows the app's own latest tag instead of a digest that goes stale every build",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/junkerderprovinz/rustdesk"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Rust and rustdesk-api images from ARG RUST_IMAGE and ARG API_IMAGE",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG (?:RUST|API)_IMAGE=(?<depName>[^:s]+):(?<currentValue>[^s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
